Approach 1(Optimal)
class Solution {
    public int findMaxConsecutiveOnes(int[] nums) {
        int count = 0;
        int max = 0;

        for (int num : nums) {
            if (num == 1) {
                count++;
                max = Math.max(max, count);
            } else {
                count = 0;
            }
        }

        return max;
    }
}

Complexity
Time = O(n)
Space = O(1)

Approach 2(One pass - Optimal)

class Solution {
    public int findMaxConsecutiveOnes(int[] nums) {
       int count=0;
       int i=0;
       int greatest_count=0;
       while(i<nums.length) 
       {
            if(nums[i]==1)
            {
                count++;
                i++;
                if(count>greatest_count)
                {
                    greatest_count=count;
                }
            }
            else if(nums[i]==0)
            {
                count=0;
                i++;
            }   
       }
       return greatest_count;
    }
}

Complexity:
Time=O(n)
Space=O(1)
